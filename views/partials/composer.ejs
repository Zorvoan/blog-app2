<%# Pole pro psaní (nový příspěvek z hlavní stránky / komentář). Parametry: action, queueLabel, placeholder,
    textLabel, maxlength, submitLabel; u příspěvku navíc kind: 'post' (titulek, rubrika, publikace). %>
<form class="composer media<%= locals.kind === 'post' ? '' : ' compact' %>" method="post" action="<%= action %>" data-offline-queue="<%= queueLabel %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <%- include('avatar', { name: user.username, display: user.display_name }) %>
  <div class="composer-main">
    <% if (locals.kind === 'post') { %><input class="composer-title" name="title" placeholder="Titulek" required maxlength="300" aria-label="Titulek"><% } %>
    <textarea class="composer-text" name="body" rows="2" placeholder="<%= placeholder %>" maxlength="<%= maxlength %>" aria-label="<%= textLabel %>"<%= locals.kind === 'post' ? '' : ' required' %> data-autogrow></textarea>
    <div class="composer-bar">
      <% if (locals.kind === 'post') { %>
        <select name="category_id" aria-label="Rubrika">
          <option value="">Bez rubriky</option>
          <% allCategories.forEach(c => { %><option value="<%= c.id %>"<%= locals.composeCategory === c.id ? ' selected' : '' %>>r/<%= c.name %></option><% }) %>
        </select>
        <a class="muted small" href="/admin/posts/new">Rozšířený editor</a>
      <% } %>
      <button class="btn btn-primary"<%- locals.kind === 'post' ? ' name="status" value="published"' : '' %>><%= submitLabel %></button>
    </div>
  </div>
</form>
