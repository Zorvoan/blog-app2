<%- include('../partials/top') %>
<% const editing = !!post; %>
<%- include('../partials/edit-head', {
  back: '/admin/posts', heading: editing ? 'Upravit příspěvek' : 'Nový příspěvek',
  viewHref: editing && '/p/' + post.id, historyHref: editing && '/admin/posts/' + post.id + '/history',
}) %>
<div class="pad">
  <%- include('../partials/errors') %>
  <form method="post" action="<%= editing ? '/admin/posts/' + post.id : '/admin/posts' %>" class="form editor-layout" data-offline-queue="<%= editing ? 'Úprava příspěvku' : 'Nový příspěvek' %>">
    <%- include('../partials/form-keys') %>
    <% if (editing) { %><input type="hidden" name="id" value="<%= post.id %>"><% } %>
    <div class="editor-main">
      <label>Titulek<input name="title" value="<%= form.title %>" required maxlength="300" class="input-lg" autofocus></label>
      <label for="body">Text</label>
      <%- include('../partials/editor', { value: form.body }) %>
    </div>
    <aside class="editor-side card">
      <label>Stav<%- include('../partials/status-select', { current: form.status }) %></label>
      <label>Rubrika
        <select name="category_id">
          <option value="">Bez rubriky</option>
          <% allCategories.forEach(c => { %><option value="<%= c.id %>"<%= String(form.category_id) === String(c.id) ? ' selected' : '' %>>r/<%= c.name %></option><% }) %>
        </select>
      </label>
      <label>Štítky<input name="tags" value="<%= form.tags %>" placeholder="např. novinky, tipy" maxlength="500"><small>Oddělte čárkou. #hashtagy z textu se přidají automaticky.</small></label>
      <% if (perms.canPinPost(user)) { %>
        <label class="check"><input type="checkbox" name="pinned" value="1"<%= form.pinned ? ' checked' : '' %>> Připnout nahoru</label>
      <% } %>
      <%- include('../partials/edit-actions', { editing, submitLabel: editing ? 'Uložit' : 'Uložit a zobrazit', previewAction: '/admin/posts/preview' }) %>
      <% if (editing) { %>
        <p class="muted small">Vytvořeno <%= formatDate(post.created_at) %><% if (post.username) { %> uživatelem @<%= post.username %><% } %>.<br>Naposledy upraveno <%= formatDate(post.updated_at) %>.</p>
      <% } %>
    </aside>
  </form>
  <% if (editing && perms.canDeletePost(user, post)) { %>
    <%- include('../partials/button-form', { action: '/admin/posts/' + post.id + '/trash', confirm: 'Přesunout příspěvek do koše?', formClass: 'danger-row', btnClass: 'btn btn-danger btn-sm', ic: 'trash', text: 'Přesunout do koše' }) %>
  <% } %>
</div>
<%- include('../partials/bottom') %>
