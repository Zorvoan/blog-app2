<%- include('../partials/top') %>
<%- include('../partials/edit-head', { back: base + '/' + item.id + '/edit', heading: 'Historie změn', viewHref: entity === 'post' ? '/p/' + item.id : '/pages/' + item.slug }) %>
<div class="pad">
  <p><strong><%= item.title %></strong> · <%= revs.length %> revizí</p>
  <ol class="timeline">
    <% revs.forEach((r, i) => { %>
      <li>
        <details<%= i === 0 ? ' open' : '' %>>
          <summary>
            <%- include('../partials/avatar', { name: r.editor_username, display: r.editor_name, size: 'sm' }) %>
            <span>
              <strong>#<%= r.id %></strong> · <%= r.note || 'Upraveno' %>
              <span class="muted">– <%= r.editor_username ? '@' + r.editor_username : 'smazaný uživatel' %>, <%= formatDate(r.created_at) %></span>
              <% if (i === 0) { %><span class="badge badge-ok">Aktuální</span><% } %>
            </span>
          </summary>
          <div class="rev-body">
            <h3><%= r.title %></h3>
            <div class="prose"><%- renderText(r.body) %></div>
            <% if (i > 0) { %>
              <%- include('../partials/button-form', { action: base + '/' + item.id + '/revisions/' + r.id + '/restore', confirm: 'Obnovit tuto verzi? Aktuální obsah zůstane v historii.', btnClass: 'btn btn-sm', ic: 'history', text: 'Obnovit tuto verzi' }) %>
            <% } %>
          </div>
        </details>
      </li>
    <% }) %>
  </ol>
</div>
<%- include('../partials/bottom') %>
