<%- include('../partials/top') %>
<%- include('../partials/edit-head', { back: backUrl, heading: 'Upravit rubriku', viewHref: '/c/' + cat.slug }) %>
<div class="pad narrow">
  <%- include('../partials/errors') %>
  <%- include('category-fields', { action: '/admin/categories/' + cat.id, submit: 'Uložit rubriku' }) %>
  <% if (perms.canDeleteCategory(user, cat)) { %>
    <section class="card danger-zone">
      <h3>Smazat rubriku</h3>
      <form method="post" action="/admin/categories/<%= cat.id %>/delete" class="form" data-confirm="Smazat rubriku r/<%= cat.name %>?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="back" value="<%= backUrl %>">
        <label>Příspěvky přesunout do
          <select name="move_to">
            <option value="">Bez rubriky</option>
            <% allCategories.filter(c => c.id !== cat.id).forEach(c => { %><option value="<%= c.id %>">r/<%= c.name %></option><% }) %>
          </select>
        </label>
        <button class="btn btn-danger">Smazat rubriku</button>
      </form>
    </section>
  <% } %>
</div>
<%- include('../partials/bottom') %>
