<%- include('partials/top') %>
<div class="col-head sticky">
  <a class="plain-btn icon-btn" href="<%= post.cat_slug ? '/c/' + post.cat_slug : '/' %>" aria-label="Zpět" data-back><%- icon('back') %></a>
  <h1>Příspěvek</h1>
</div>
<%- include('partials/preview-banner') %>
<%- include('partials/post-card', { post, fullView: true }) %>

<% if (post.id) { %>
<section class="comments" id="comments">
  <h2 class="section-title">Komentáře (<%= comments.length %>)</h2>
  <% if (user && post.status === 'published' && !post.deleted_at) { %>
    <%- include('partials/composer', { action: '/p/' + post.id + '/comments', queueLabel: 'Komentář', placeholder: 'Napište odpověď…', textLabel: 'Komentář', maxlength: 5000, submitLabel: 'Odpovědět' }) %>
  <% } else if (!user) { %>
    <p class="pad muted"><a href="/login?next=/p/<%= post.id %>">Přihlaste se</a> a zapojte se do diskuze.</p>
  <% } %>
  <% comments.forEach(c => { %>
    <article class="media comment" id="comment-<%= c.id %>">
      <%- include('partials/avatar', { name: c.username, display: c.display_name }) %>
      <div class="comment-main">
        <header class="post-meta">
          <div class="meta-text">
            <% if (c.username) { %><a class="author" href="/u/<%= c.username %>"><%= c.display_name %></a> <span class="handle">@<%= c.username %></span><% } else { %><span class="muted">[smazaný uživatel]</span><% } %>
            <span class="sep">·</span><time datetime="<%= c.created_at %>" title="<%= formatDate(c.created_at) %>"><%= timeAgo(c.created_at) %></time>
          </div>
          <% if (perms.canDeleteComment(user, c)) { %>
            <%- include('partials/button-form', { action: '/comments/' + c.id + '/delete', confirm: 'Smazat komentář?', btnClass: 'plain-btn icon-btn sm danger', ic: 'trash', label: 'Smazat komentář' }) %>
          <% } %>
        </header>
        <div class="prose"><%- renderText(c.body) %></div>
      </div>
    </article>
  <% }) %>
</section>
<% } %>
<%- include('partials/bottom') %>
